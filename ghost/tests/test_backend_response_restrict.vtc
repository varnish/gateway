varnishtest "router.backend_fetch()/backend_response() are restricted to their subroutines"

# It writes beresp.ttl/grace/keep/uncacheable through the VRT setters, which
# need a backend fetch context. VCC must reject any other call site.

shell {
    echo '{"version": 2, "vhosts": {}}' > ${tmpdir}/ghost.json
}

varnish v1 -arg "-p thread_pool_stack=160k" -errvcl {Not available in subroutine 'vcl_recv'} {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_recv {
        router.backend_response();
    }
}

varnish v1 -errvcl {Not available in subroutine 'vcl_backend_error'} {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_backend_error {
        router.backend_response();
    }
}

varnish v1 -errvcl {Not available in subroutine 'vcl_backend_response'} {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_backend_response {
        router.backend_fetch();
    }
}
