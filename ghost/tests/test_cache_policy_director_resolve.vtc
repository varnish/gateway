varnishtest "internal cache headers never reach the origin when routing runs via director resolve()"

# When bereq.backend is the ghost director (router.backend(), or recv()'s
# fallback on a backend-pool miss), Varnish resolves it after
# vcl_backend_fetch and ghost re-runs routing on bereq. That must not put
# X-Ghost-Cache-Policy / X-Ghost-Cache-Key-Extra back on the request sent to
# the origin, and the directive captured by backend_fetch() must still apply.

server s1 {
    rxreq
    expect req.http.X-Ghost-Cache-Policy == <undef>
    expect req.http.X-Ghost-Cache-Key-Extra == <undef>
    # max-age=0: only the policy's forced TTL can make the next request a hit
    txresp -hdr "Cache-Control: max-age=0" -body "r-1"
} -start

shell {
    cat > ${tmpdir}/ghost.json <<EOF2
{
    "version": 2,
    "vhosts": {
        "r.example.com": {
            "routes": [{
                "backend_groups": [{"weight": 100, "backends": [{"address": "${s1_addr}", "port": ${s1_port}}]}],
                "priority": 100,
                "cache_policy": {
                    "forced_ttl_seconds": 300,
                    "cache_key": {"headers": ["X-Variant"]}
                }
            }]
        }
    }
}
EOF2
}

varnish v1 -arg "-p thread_pool_stack=160k" -vcl {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_recv {
        if (req.url == "/.varnish-ghost/reload") {
            if (router.reload()) {
                return (synth(200, "OK"));
            } else {
                return (synth(500, "Reload failed"));
            }
        }
        set req.backend_hint = router.recv();
        if (req.http.X-Ghost-Pass) {
            return (pass);
        }
    }

    sub vcl_hash {
        if (req.http.X-Ghost-Cache-Key-Extra) {
            hash_data(req.http.X-Ghost-Cache-Key-Extra);
            unset req.http.X-Ghost-Cache-Key-Extra;
        }
    }

    sub vcl_backend_fetch {
        router.backend_fetch();
        set bereq.backend = router.backend();
    }

    sub vcl_backend_response {
        router.backend_response();
    }
} -start

client c1 {
    txreq -url "/" -hdr "Host: r.example.com" -hdr "X-Variant: a"
    rxresp
    expect resp.status == 200
    expect resp.body == "r-1"
    txreq -url "/" -hdr "Host: r.example.com" -hdr "X-Variant: a"
    rxresp
    expect resp.status == 200
    expect resp.body == "r-1"
} -run

server s1 -wait
