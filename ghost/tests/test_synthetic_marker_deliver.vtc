varnishtest "deliver() strips X-Ghost-Synthetic even without backend_response()"

# Custom VCL that never calls router.backend_response(): the marker (ghost's
# per-process token) is still on the object, and ghost.deliver() must remove
# it so the token never reaches clients.
shell {
    cat > ${tmpdir}/ghost.json <<EOF
{
    "version": 2,
    "vhosts": {
        "app.example.com": {
            "routes": [{
                "backend_groups": [],
                "priority": 100
            }]
        }
    }
}
EOF
}

varnish v1 -arg "-p thread_pool_stack=160k" -vcl {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_recv {
        set req.backend_hint = router.recv();
    }

    sub vcl_deliver {
        ghost.deliver();
    }
} -start

# ghost-generated 404 (unknown vhost) and 500 (route without backends)
client c1 {
    txreq -url "/" -hdr "Host: unknown.example.com"
    rxresp
    expect resp.status == 404
    expect resp.http.X-Ghost-Synthetic == <undef>
    txreq -url "/" -hdr "Host: app.example.com"
    rxresp
    expect resp.status == 500
    expect resp.http.X-Ghost-Synthetic == <undef>
} -run
