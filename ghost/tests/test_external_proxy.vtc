varnishtest "ghost external proxy via reqwest-backed synthetic backend"

# Upstream — simulates an ExternalName target like an S3 endpoint.
# Don't constrain Host here — reqwest builds it from the upstream URL.
server s1 {
    rxreq
    expect req.method == "GET"
    expect req.url == "/media/asset.png"
    txresp -hdr "X-From: upstream" -body "binary-blob"

    rxreq
    expect req.method == "POST"
    expect req.http.Content-Type == "application/json"
    expect req.http.Content-Length == "7"
    expect req.body == "{\"x\":1}"
    txresp -status 201 -body "created"

    rxreq
    expect req.method == "PUT"
    expect req.body == "replacement"
    txresp -status 204

    rxreq
    expect req.method == "DELETE"
    expect req.http.Content-Length == <undef>
    expect req.bodylen == 0
    txresp -status 204

    # chunked client body is buffered and re-sent with a Content-Length
    rxreq
    expect req.method == "POST"
    expect req.http.Transfer-Encoding == <undef>
    expect req.http.Content-Length == "11"
    expect req.body == "hello world"
    txresp -body "ok"
} -start

# Write ghost.json with an external_proxy group instead of native backends.
# The address points at the VTC server so reqwest connects to it via plain HTTP.
shell {
    cat > ${tmpdir}/ghost.json <<EOF
{
    "version": 2,
    "vhosts": {
        "preview.example.com": {
            "routes": [
                {
                    "path_match": {"type": "PathPrefix", "value": "/media"},
                    "backend_groups": [{
                        "weight": 100,
                        "backends": [],
                        "external_proxy": {
                            "hostname": "${s1_addr}",
                            "port": ${s1_port},
                            "tls": false
                        }
                    }],
                    "priority": 10700,
                    "route_name": "web2026/web-https"
                }
            ]
        }
    }
}
EOF
}

varnish v1 -arg "-p thread_pool_stack=160k" -vcl {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_recv {
        set req.backend_hint = router.recv();
        if (req.http.X-Ghost-Pass == "true") {
            return (pass);
        }
    }
} -start

client c1 {
    txreq -url "/media/asset.png" -hdr "Host: preview.example.com"
    rxresp
    expect resp.status == 200
    expect resp.http.X-From == "upstream"
    expect resp.body == "binary-blob"
} -run

# Body-bearing methods are forwarded with their body to the upstream.
client c2 {
    txreq -req POST -url "/media/asset.png" \
        -hdr "Host: preview.example.com" \
        -hdr "Content-Type: application/json" \
        -body "{\"x\":1}"
    rxresp
    expect resp.status == 201
    expect resp.body == "created"

    txreq -req PUT -url "/media/asset.png" \
        -hdr "Host: preview.example.com" \
        -body "replacement"
    rxresp
    expect resp.status == 204

    txreq -req DELETE -url "/media/asset.png" \
        -hdr "Host: preview.example.com"
    rxresp
    expect resp.status == 204

    txreq -req POST -url "/media/asset.png" -nolen \
        -hdr "Host: preview.example.com" \
        -hdr "Transfer-Encoding: chunked"
    chunked "hello "
    chunked "world"
    chunkedlen 0
    rxresp
    expect resp.status == 200
    expect resp.body == "ok"
} -run
