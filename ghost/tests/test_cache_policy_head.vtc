varnishtest "cacheRuleOverrides: a method GET rule applies when the miss came from HEAD"

# Varnish fetches a HEAD miss as GET and stores one object for HEAD and GET.
# The rule's forced TTL must therefore apply even though the client sent HEAD:
# the origin says max-age=0, so only the forced TTL makes the GET a hit.
server s1 {
    rxreq
    expect req.method == "GET"
    txresp -hdr "Cache-Control: max-age=0" -body "body"
} -start

shell {
    cat > ${tmpdir}/ghost.json <<EOF
{
    "version": 2,
    "vhosts": {
        "app.example.com": {
            "routes": [{
                "backend_groups": [{"weight": 100, "backends": [{"address": "${s1_addr}", "port": ${s1_port}}]}],
                "priority": 100,
                "cache_policy": {
                    "overrides": [{"match": {"method": "GET"}, "forced_ttl_seconds": 300}]
                }
            }]
        }
    }
}
EOF
}

varnish v1 -arg "-p thread_pool_stack=160k" -vcl {
    import ghost from "${vmod}";

    backend dummy none;

    sub vcl_init {
        ghost.init("${tmpdir}/ghost.json");
        new router = ghost.ghost_backend();
    }

    sub vcl_recv {
        set req.backend_hint = router.recv();
    }

    sub vcl_backend_fetch {
        router.backend_fetch();
    }

    sub vcl_backend_response {
        router.backend_response();
    }
} -start

client c1 {
    txreq -method HEAD -url "/" -hdr "Host: app.example.com"
    rxresphdrs
    expect resp.status == 200
    txreq -url "/" -hdr "Host: app.example.com"
    rxresp
    expect resp.status == 200
    expect resp.body == "body"
} -run

server s1 -wait
varnish v1 -expect cache_hit == 1
